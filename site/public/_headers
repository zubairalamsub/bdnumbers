# Cloudflare Pages headers
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Security headers for every page. The CSP leaves script sources open on purpose: AdSense loads
# scripts from many Google hosts and does not support an allowlist. It still blocks other sites from
# framing these pages, plugins, <base> hijacking, forms posting elsewhere and mixed content.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://buttondown.com; upgrade-insecure-requests
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), hid=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups

/feed.xml
  Content-Type: application/atom+xml; charset=utf-8
/en/feed.xml
  Content-Type: application/atom+xml; charset=utf-8
/rss.xml
  Content-Type: application/rss+xml; charset=utf-8
/en/rss.xml
  Content-Type: application/rss+xml; charset=utf-8

# The pages.dev copy of the site stays out of search results; bdrate.fyi is the only indexed host.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json
/en/manifest.webmanifest
  Content-Type: application/manifest+json
