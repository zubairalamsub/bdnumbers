---
import { defaultDigits, type Lang } from '@bdnumbers/shared';
import { formatDateTime } from '../lib/view';

interface Props {
  /** ISO timestamp. */
  at: string | null;
  lang: Lang;
  field?: string;
  /** Status-table cell name the browser script updates. */
  cell?: string;
}

// Rendered as an absolute Dhaka time (correct without JavaScript and for crawlers); the browser
// script turns it into "5 minutes ago" and keeps it ticking.
const { at, lang, field, cell } = Astro.props;
---

<time datetime={at ?? undefined} data-ago={at ?? ''} data-field={field} data-cell={cell} hidden={!at}>
  {at ? formatDateTime(at, lang, defaultDigits(lang)) : ''}
</time>
