---
import type { Lang } from '@bdnumbers/shared';
import { STRINGS, localePath } from '../i18n';
import { breadcrumbLd, ldJson } from '../lib/seo';

interface Props {
  lang: Lang;
  /** Crumbs after Home; the last one is the current page. */
  items: Array<{ label: string; path: string }>;
}

const { lang, items } = Astro.props;
const s = STRINGS[lang];
const crumbs = [{ label: s.nav.home, path: '/' }, ...items];
---

<nav aria-label={s.breadcrumbs} class="mb-3 text-sm text-ink-2">
  <ol class="flex flex-wrap gap-1">
    {
      crumbs.map((c, i) => (
        <li class="flex gap-1">
          {i > 0 && <span aria-hidden="true">›</span>}
          {i === crumbs.length - 1 ? (
            <span aria-current="page">{c.label}</span>
          ) : (
            <a href={localePath(lang, c.path)} class="-my-1.5 inline-block py-1.5 text-ink-2">
              {c.label}
            </a>
          )}
        </li>
      ))
    }
  </ol>
  <script type="application/ld+json" is:inline set:html={ldJson(breadcrumbLd(lang, crumbs))} />
</nav>
