---
import { defaultDigits, type Lang } from '@bdnumbers/shared';
import { formatPointDate } from '../lib/view';

interface Props {
  date: string;
  lang: Lang;
  field?: string;
}

const { date, lang, field } = Astro.props;
---

<time datetime={date} data-date={date} data-field={field}>{formatPointDate(date, lang, defaultDigits(lang))}</time>
