---
import type { Lang } from '@bdnumbers/shared';
import { SITE_NAME } from '../config';
import { STRINGS, localePath } from '../i18n';
import DigestSignup from './DigestSignup.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = STRINGS[lang];
const pages = [
  { path: '/dollar-rate-today', label: s.nav.dollar },
  { path: '/currency/saudi-riyal', label: lang === 'bn' ? 'সৌদি রিয়াল রেট' : 'Saudi riyal rate' },
  { path: '/gold-price-today', label: s.nav.gold },
  { path: '/silver-price-today', label: s.nav.silver },
  { path: '/market-price-today', label: s.nav.market },
  { path: '/share-market-today', label: s.nav.stock },
  { path: '/fuel-price', label: s.nav.fuel },
  { path: '/lpg-price', label: s.nav.lpg },
  { path: '/savings-rates', label: s.nav.savings },
  { path: '/weather', label: s.nav.weather },
  { path: '/prayer-times', label: s.nav.prayer },
  { path: '/holidays', label: s.nav.holidays },
  { path: '/calculators', label: s.nav.calculators },
  { path: '/status', label: s.nav.status },
  { path: '/about', label: s.nav.about },
  { path: '/privacy', label: s.nav.privacy },
];
---

<footer class="border-t border-hairline bg-surface">
  <div class="mx-auto max-w-5xl space-y-4 px-4 py-6 text-sm text-ink-2 sm:px-6">
    <DigestSignup lang={lang} />
    <nav aria-label={s.nav.allPages} id="all-pages">
      <ul class="grid grid-cols-2 gap-x-4 sm:flex sm:flex-wrap sm:gap-y-1">
        {pages.map((p) => <li><a href={localePath(lang, p.path)} class="block py-2 text-ink-2 sm:py-0">{p.label}</a></li>)}
      </ul>
    </nav>
    <p>{s.footer}</p>
    <p>{SITE_NAME}</p>
  </div>
</footer>
