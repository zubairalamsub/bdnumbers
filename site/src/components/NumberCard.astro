---
import { fractionDigits, unitLabel, type Lang, type LatestEntry } from '@bdnumbers/shared';
import { STRINGS } from '../i18n';
import ChangeText from './ChangeText.astro';
import EntryMeta from './EntryMeta.astro';
import Num from './Num.astro';

interface Props {
  entry: LatestEntry;
  lang: Lang;
  /** The one headline figure of the page (48px). */
  hero?: boolean;
  label?: string;
  href?: string;
  headingLevel?: 2 | 3;
}

const { entry, lang, hero = false, label, href, headingLevel = 2 } = Astro.props;
const s = STRINGS[lang];
const name = label ?? (lang === 'bn' ? entry.name_bn : entry.name_en);
const Heading = headingLevel === 2 ? 'h2' : 'h3';
---

<article class="card flex flex-col gap-1 p-4 sm:p-5" data-series={entry.key}>
  <Heading class="text-[0.9375rem] font-semibold text-ink-2">
    {href ? <a href={href} class="text-ink-2 no-underline hover:underline">{name}</a> : name}
  </Heading>
  <p class:list={['font-semibold leading-tight text-ink', hero ? 'text-5xl' : 'text-3xl']}>
    <Num value={entry.value} fd={fractionDigits(entry.category, entry.value)} lang={lang} field="value" />
    <span class:list={['ml-1 font-normal text-ink-2', hero ? 'text-xl' : 'text-base']}>{unitLabel(entry.unit, lang)}</span>
  </p>
  <p class="text-sm text-ink-2">
    <ChangeText change={entry.change.prev} category={entry.category} lang={lang} field="change.prev" class="font-semibold text-ink" />
    {entry.change.prev && <span> {s.vs.prev}</span>}
  </p>
  <slot />
  <EntryMeta entry={entry} lang={lang} />
</article>
