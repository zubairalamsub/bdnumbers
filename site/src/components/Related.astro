---
import type { Lang } from '@bdnumbers/shared';
import { STRINGS, localePath } from '../i18n';

interface Props {
  lang: Lang;
  links: Array<{ label: string; path: string }>;
}

const { lang, links } = Astro.props;
const s = STRINGS[lang];
---

<section class="mt-10">
  <h2 class="mb-2 text-lg font-semibold">{s.related}</h2>
  <ul class="flex flex-wrap gap-2">
    {
      links.map((l) => (
        <li>
          <a href={localePath(lang, l.path)} class="card inline-block px-3 py-1.5 text-[0.9375rem] no-underline hover:underline">
            {l.label}
          </a>
        </li>
      ))
    }
  </ul>
</section>
