---
import type { Lang } from '@bdnumbers/shared';
import { Font } from 'astro:assets';
import BottomNav from '../components/BottomNav.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { ADSENSE_CLIENT, API_BASE, SITE_NAME, SITE_URL } from '../config';
import { localePath } from '../i18n';
import { ogImagePath } from '../lib/og-cards';
import { fitDescription, fitTitle, ldJson, type JsonLd } from '../lib/seo';
import '../styles/global.css';

interface Props {
  lang: Lang;
  /** Path without the language prefix, e.g. '/dollar-rate-today'. */
  path: string;
  /** Title variants, best first, without the site name: the first that fits 60 characters is used. */
  title: string | readonly string[];
  /** Description variants, best first: the first that fits 155 characters is used. */
  description: string | readonly string[];
  /** When the page's data was generated (latest.json generated_at); drives the client refresh. */
  generatedAt: string;
  noindex?: boolean;
  /** Page-level JSON-LD (breadcrumbs and FAQs add their own). */
  jsonLd?: readonly JsonLd[];
}

const { lang, path, generatedAt, noindex = false, jsonLd = [] } = Astro.props;
const title = fitTitle(Astro.props.title);
const description = fitDescription(Astro.props.description);
const ogImage = `${SITE_URL}${ogImagePath(lang, path, generatedAt.replace(/\D/g, '').slice(0, 12))}`;
const canonical = `${SITE_URL}${localePath(lang, path)}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      !noindex && (
        <>
          <link rel="alternate" hreflang="bn" href={`${SITE_URL}${localePath('bn', path)}`} />
          <link rel="alternate" hreflang="en" href={`${SITE_URL}${localePath('en', path)}`} />
          <link rel="alternate" hreflang="x-default" href={`${SITE_URL}${localePath('bn', path)}`} />
        </>
      )
    }
    <meta name="robots" content={noindex ? 'noindex' : 'max-image-preview:large'} />
    {ADSENSE_CLIENT && <meta name="google-adsense-account" content={ADSENSE_CLIENT} />}
    <meta name="theme-color" content="#006a4e" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1a19" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href={localePath(lang, '/manifest.webmanifest')} />
    <link rel="preconnect" href={API_BASE} crossorigin />
    <link rel="alternate" type="application/atom+xml" title={lang === 'bn' ? `${SITE_NAME}: আজ যা বদলেছে` : `${SITE_NAME}: what changed today`} href={localePath(lang, '/feed.xml')} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} RSS`} href={localePath(lang, '/rss.xml')} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'bn' ? 'bn_BD' : 'en_US'} />
    {!noindex && <meta property="og:locale:alternate" content={lang === 'bn' ? 'en_US' : 'bn_BD'} />}
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    {/* Preload only the script this page is written in; the other loads on demand. */}
    <Font cssVariable="--font-bn" preload={[{ subset: lang === 'bn' ? 'bengali' : 'latin' }]} />
    {jsonLd.map((data) => <script type="application/ld+json" is:inline set:html={ldJson(data)} />)}
  </head>
  <body class="min-h-screen pb-[calc(3.5rem+env(safe-area-inset-bottom))] font-sans antialiased sm:pb-0" data-api={API_BASE} data-generated={generatedAt}>
    <Header lang={lang} path={path} />
    <main class="mx-auto max-w-5xl px-4 pb-16 pt-6 sm:px-6">
      <slot />
    </main>
    <Footer lang={lang} />
    <BottomNav lang={lang} path={path} />
    <script>
      import '../scripts/live';
      import '../scripts/pwa';
    </script>
  </body>
</html>
