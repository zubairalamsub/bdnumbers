---
import {
  KARAT_ORDER,
  PHONE_SHOPS,
  addDays,
  currencyName,
  defaultDigits,
  dhakaDate,
  formatDate,
  formatNumber,
  formatSeriesValue,
  fractionDigits,
  getSeriesDef,
  TCB_ITEMS,
  WEATHER_CITIES,
  unitLabel,
  weatherCondition,
  type Holiday,
  type Lang,
} from '@bdnumbers/shared';
import CardHead from '../components/CardHead.astro';
import ChangeText from '../components/ChangeText.astro';
import Num from '../components/Num.astro';
import NumberCard from '../components/NumberCard.astro';
import UsdBackup from '../components/UsdBackup.astro';
import { STRINGS, localePath } from '../i18n';
import Base from '../layouts/Base.astro';
import { CALCULATORS } from '../lib/calculators';
import { commodityOf, commodityPath } from '../lib/commodities';
import { currencyByCode, currencyPath, pegEntry } from '../lib/currencies';
import { homeLd } from '../lib/seo';
import { getChanges, getEntries, getHistory, getLatest, getPhones } from '../lib/data';
import { PHONES_PATH, lowestPrice, phonePath, popular } from '../lib/phones';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = STRINGS[lang];
const digits = defaultDigits(lang);
const latest = await getLatest();
const [usd, bid, ask] = await getEntries(['usd_bdt_avg', 'usd_bdt_low', 'usd_bdt_high']);
const gold = await getEntries(KARAT_ORDER.map((k) => `gold_${k}`));
const crossCodes = ['eur', 'gbp', 'inr', 'sgd'].filter((c) => latest.series.some((e) => e.key === `${c}_bdt_ask`));
// Gulf currencies first (most remittances come from there), at the dollar's ask over their peg, then cross rates.
const otherCurrencies = [
  ...['sar', 'aed'].map((code) => ({ code, entry: pegEntry(ask!, currencyByCode(code)!) })),
  ...(await getEntries(crossCodes.map((c) => `${c}_bdt_ask`))).map((entry, i) => ({ code: crossCodes[i]!, entry })),
];
// A series' first value isn't a change, and hourly weather would drown out everything else.
const changed = (await getChanges()).changes.filter(
  (c) => c.previous !== null && getSeriesDef(c.key)?.category !== 'weather',
);
const byKey = new Map(latest.series.map((e) => [e.key, e]));
const marketItems = ['rice_coarse', 'soybean_oil_loose', 'onion_local', 'potato', 'lentil_bold', 'egg', 'chicken_broiler', 'sugar']
  .map((id) => ({ item: TCB_ITEMS.find((i) => i.id === id)!, min: byKey.get(`tcb_${id}_min`), max: byKey.get(`tcb_${id}_max`) }))
  .filter((r) => r.min && r.max);
const dsex = byKey.get('dse_dsex');
const turnover = byKey.get('dse_turnover');
const weatherCities = ['dhaka', 'chattogram', 'sylhet', 'rajshahi']
  .map((id) => ({ city: WEATHER_CITIES.find((c) => c.id === id)!, temp: byKey.get(`weather_${id}_temp`) }))
  .filter((c) => c.temp !== undefined);
const [silver, ...silverRest] = await getEntries(KARAT_ORDER.map((k) => `silver_${k}`));
const today = dhakaDate();
// The last 90 days of the dollar and the share index, for the small trend lines on their cards.
const since = addDays(today, -90);
const recent = async (key: string) => (await getHistory(key)).points.filter((p) => p.date >= since).map((p): [string, number] => [p.date, p.value]);
const [usdTrend, dsexTrend] = await Promise.all([recent('usd_bdt_avg'), dsex ? recent('dse_dsex') : Promise.resolve([])]);
const trendLabel = lang === 'bn' ? 'গত ৯০ দিন' : 'Last 90 days';
// Phones most shops have in stock, cheapest first.
const phones = await getPhones();
const phonePicks = popular(phones.models.filter((m) => lowestPrice(m) !== null), 8);
const holidays = (byKey.get('holidays_public')?.meta?.holidays as Holiday[] | undefined) ?? [];
const nextHolidays = holidays.filter((h) => h.type === 'public' && h.date >= today).slice(0, 3);
const fuels = ['fuel_diesel', 'fuel_octane', 'fuel_petrol', 'lpg_12kg'].map((k) => byKey.get(k)).filter((e) => e !== undefined);

const usdText = formatSeriesValue(usd!.value, 'fx', digits);
const goldText = formatSeriesValue(gold[0]!.value, 'gold', digits);
const title =
  lang === 'bn'
    ? [`আজকের রেট ও দাম: ডলার ${usdText}, সোনা ${goldText} টাকা`, `আজকের রেট ও দাম: ডলার ${usdText} টাকা`]
    : [`Bangladesh rates today: dollar Tk ${usdText}, gold Tk ${goldText}`, `Bangladesh rates today: dollar Tk ${usdText}`];
const description =
  lang === 'bn'
    ? `আজ বাংলাদেশ ব্যাংকের ডলার রেট ${usdText} টাকা, ২২ ক্যারেট সোনা প্রতি ভরি ${goldText} টাকা। ডলার, ইউরো, পাউন্ড, রুপি এবং সোনা-রুপার দাম প্রতিদিন হালনাগাদ।`
    : `Today's Bangladesh Bank dollar rate is Tk ${usdText} and 22K gold is Tk ${goldText} per bhori. Dollar, euro, pound, rupee, gold and silver prices, updated daily.`;
---

<Base lang={lang} path="/" title={title} description={description} generatedAt={latest.generated_at} jsonLd={homeLd(lang, description)}>
  <h1 class="text-xl font-semibold sm:text-3xl">{s.tagline}</h1>
  <p class="mt-1 text-sm text-ink-2 sm:text-base">
    {lang === 'bn' ? 'সরকারি ও মূল উৎস থেকে নেওয়া, দিনে কয়েকবার নিজে থেকে হালনাগাদ।' : 'From official and primary sources, updated by itself several times a day.'}
  </p>

  <div class="mt-5 grid gap-4 md:grid-cols-2">
    <NumberCard entry={usd!} lang={lang} hero href={localePath(lang, '/dollar-rate-today')} label={s.nav.dollar} trend={usdTrend} trendLabel={trendLabel}>
      <p class="flex flex-wrap gap-x-4 text-sm text-ink-2">
        <span data-series={bid!.key}>{s.table.bid}: <Num value={bid!.value} fd={2} lang={lang} field="value" class="font-semibold text-ink" /></span>
        <span data-series={ask!.key}>{s.table.ask}: <Num value={ask!.value} fd={2} lang={lang} field="value" class="font-semibold text-ink" /></span>
      </p>
      <UsdBackup lang={lang} usd={usd!} compact />
    </NumberCard>

    <NumberCard
      entry={gold[0]!}
      lang={lang}
      href={localePath(lang, '/gold-price-today')}
      label={`${s.nav.gold} · ${s.karats['22k']} (${s.table.perBhori})`}
    >
      <ul class="mt-1 divide-y divide-grid text-[0.9375rem]">
        {
          gold.slice(1).map((e, i) => (
            <li class="flex justify-between gap-3 py-1" data-series={e.key}>
              <span class="text-ink-2">{s.karats[KARAT_ORDER[i + 1]!]}</span>
              <span>
                <Num value={e.value} lang={lang} field="value" class="font-semibold" />
                <ChangeText change={e.change.prev} category="gold" lang={lang} field="change.prev" class="ml-2 text-sm text-ink-2" />
              </span>
            </li>
          ))
        }
      </ul>
    </NumberCard>
  </div>

  <div class="mt-4 grid gap-4 md:grid-cols-2">
    <NumberCard
      entry={silver!}
      lang={lang}
      href={localePath(lang, '/silver-price-today')}
      label={`${s.nav.silver} · ${s.karats['22k']} (${s.table.perBhori})`}
    >
      <ul class="mt-1 divide-y divide-grid text-[0.9375rem]">
        {
          silverRest.map((e, i) => (
            <li class="flex justify-between gap-3 py-1" data-series={e.key}>
              <span class="text-ink-2">{s.karats[KARAT_ORDER[i + 1]!]}</span>
              <span>
                <Num value={e.value} lang={lang} field="value" class="font-semibold" />
                <ChangeText change={e.change.prev} category="silver" lang={lang} field="change.prev" class="ml-2 text-sm text-ink-2" />
              </span>
            </li>
          ))
        }
      </ul>
    </NumberCard>

    <section class="card overflow-x-auto p-4 sm:p-5">
      <CardHead icon="coins" hue="fx" href={localePath(lang, '/dollar-rate-today')}>{lang === 'bn' ? 'অন্যান্য মুদ্রা (আস্ক)' : 'Other currencies (ask)'}</CardHead>
      <table class="data-table text-[0.9375rem]">
        <tbody>
          {
            otherCurrencies.map(({ code, entry: e }) => (
              <tr data-series={e.key}>
                <th scope="row" class="font-normal">
                  <a href={localePath(lang, currencyPath(currencyByCode(code)!))} class="text-ink no-underline hover:underline">
                    {currencyByCode(code)?.[lang] ?? currencyName(code, lang)}
                  </a>
                </th>
                <td>
                  <Num value={e.value} fd={fractionDigits('fx', e.value)} lang={lang} field="value" />
                </td>
                <td>
                  <ChangeText change={e.change.prev} category="fx" lang={lang} field="change.prev" empty="dash" class="text-sm text-ink-2" />
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>
  </div>

  <div class="mt-4 grid gap-4 md:grid-cols-3">
    {
      marketItems.length > 0 && (
        <section class="card p-4 sm:p-5">
          <CardHead icon="market" hue="market" href={localePath(lang, '/market-price-today')}>{s.nav.market} ({s.market.city})</CardHead>
          <ul class="divide-y divide-grid text-[0.9375rem]">
            {marketItems.map((r) => (
              <li class="flex justify-between gap-3 py-1">
                <a href={localePath(lang, commodityPath(commodityOf(r.item.id)!))} class="text-ink no-underline hover:underline">
                  {lang === 'bn' ? r.item.bn : r.item.en}
                </a>
                <span class="whitespace-nowrap text-right">
                  <span class="font-semibold">
                    <span data-series={r.min!.key}><Num value={r.min!.value} lang={lang} field="value" /></span>–<span data-series={r.max!.key}><Num value={r.max!.value} lang={lang} field="value" /></span>
                  </span>
                  <span class="block text-xs text-muted">{unitLabel(`BDT/${r.item.unit}`, lang)}</span>
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      dsex && (
        <NumberCard entry={dsex} lang={lang} href={localePath(lang, '/share-market-today')} label={`${s.nav.stock} · DSEX`} trend={dsexTrend} trendLabel={trendLabel}>
          {turnover && (
            <p class="text-sm text-ink-2" data-series={turnover.key}>
              {lang === 'bn' ? 'লেনদেন' : 'Turnover'}: <Num value={turnover.value} fd={2} lang={lang} field="value" class="font-semibold text-ink" />{' '}
              {unitLabel('BDT crore', lang)}
            </p>
          )}
        </NumberCard>
      )
    }

    {
      weatherCities.length > 0 && (
        <section class="card p-4 sm:p-5">
          <CardHead icon="weather" hue="weather" href={localePath(lang, '/weather')}>{s.nav.weather}</CardHead>
          <ul class="divide-y divide-grid text-[0.9375rem]">
            {weatherCities.map(({ city, temp: e }) => {
              const sky = weatherCondition(e!.meta?.symbol, lang);
              return (
                <li class="flex items-center justify-between gap-3 py-1.5" data-series={e!.key}>
                  <span>{lang === 'bn' ? city.bn : city.en}</span>
                  <span class="text-right">
                    <span class="text-sm text-ink-2"><span class="wx-icon" data-field="icon" aria-hidden="true">{sky?.icon ?? ''}</span> <span data-field="sky">{sky?.text ?? ''}</span></span>{' '}
                    <span class="font-semibold"><Num value={e!.value} fd={1} lang={lang} field="value" />°</span>
                  </span>
                </li>
              );
            })}
          </ul>
        </section>
      )
    }
  </div>

  <div class="mt-4 grid gap-4 md:grid-cols-3">
    {
      nextHolidays.length > 0 && (
        <section class="card p-4 sm:p-5">
          <CardHead icon="calendar" hue="calendar" href={localePath(lang, '/holidays')}>{lang === 'bn' ? 'পরের সরকারি ছুটি' : 'Next public holidays'}</CardHead>
          <ul class="divide-y divide-grid text-[0.9375rem]">
            {nextHolidays.map((h, i) => (
              <li class="flex justify-between gap-3 py-1" data-day={h.date}>
                <span class:list={[i === 0 && 'font-semibold']}>{lang === 'bn' ? (h.name_bn ?? h.name) : h.name}</span>
                <span class="whitespace-nowrap text-right">
                  {formatDate(h.date, lang, digits)}
                  {i === 0 && <span class="block text-xs text-muted" data-countdown={h.date} />}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      fuels.length > 0 && (
        <section class="card p-4 sm:p-5">
          <CardHead icon="fuel" hue="fuel" href={localePath(lang, '/fuel-price')}>{lang === 'bn' ? 'জ্বালানি ও এলপিজি' : 'Fuel and LPG'}</CardHead>
          <ul class="divide-y divide-grid text-[0.9375rem]">
            {fuels.map((e) => (
              <li class="flex justify-between gap-3 py-1" data-series={e.key}>
                <span>{lang === 'bn' ? e.name_bn : e.name_en}</span>
                <span class="whitespace-nowrap text-right">
                  <Num value={e.value} fd={fractionDigits(e.category, e.value)} lang={lang} field="value" class="font-semibold" />
                  <span class="block text-xs text-muted">{unitLabel(e.unit, lang)}</span>
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="card p-4 sm:p-5">
      <CardHead icon="calculator" hue="tools" href={localePath(lang, '/calculators')}>{s.nav.calculators}</CardHead>
      <ul class="divide-y divide-grid text-[0.9375rem]">
        {CALCULATORS.slice(0, 5).map((c) => (
          <li>
            <a href={localePath(lang, `/calculators/${c.slug}`)} class="block py-2">{lang === 'bn' ? c.bn : c.en}</a>
          </li>
        ))}
        <li>
          <a href={localePath(lang, '/prayer-times')} class="block py-2">{s.nav.prayer}</a>
        </li>
      </ul>
    </section>
  </div>

  {
    phonePicks.length > 0 && (
      <section class="card mt-4 p-4 sm:p-5">
        <CardHead icon="phone" hue="phone" href={localePath(lang, PHONES_PATH)}>{lang === 'bn' ? `মোবাইলের দাম · ${formatNumber(PHONE_SHOPS.length, digits, 0)}টি দোকানের সর্বনিম্ন` : `Mobile prices · lowest of ${PHONE_SHOPS.length} shops`}</CardHead>
        <ul class="grid gap-x-8 text-[0.9375rem] md:grid-cols-2">
          {phonePicks.map((m) => (
            <li class="flex justify-between gap-3 border-b border-grid py-1">
              <a href={localePath(lang, phonePath(m))} class="text-ink no-underline hover:underline">
                {m.name}
              </a>
              <span class="whitespace-nowrap font-semibold">
                ৳<Num value={lowestPrice(m)!} lang={lang} />
              </span>
            </li>
          ))}
        </ul>
        <p class="mt-2 text-sm">
          <a href={localePath(lang, PHONES_PATH)}>
            {lang === 'bn' ? `সব ${formatNumber(phones.models.length, digits, 0)}টি ফোনের দাম তুলনা` : `Compare all ${phones.models.length} phones`}
          </a>
        </p>
      </section>
    )
  }

  {
    changed.length > 0 && (
      <section class="mt-8">
        <h2 class="mb-3 text-lg font-semibold">{lang === 'bn' ? 'আজ যা বদলেছে' : 'Changed today'}</h2>
        <ul class="card divide-y divide-grid">
          {changed.slice(0, 12).map((c) => {
            const category = getSeriesDef(c.key)?.category ?? 'fx';
            const abs = c.previous === null ? 0 : c.value - c.previous;
            return (
              <li class="grid grid-cols-[1fr_auto] items-baseline gap-x-3 px-4 py-2 text-[0.9375rem]">
                <span class="min-w-0">{lang === 'bn' ? c.name_bn : c.name_en}</span>
                <span class="text-right">
                  <Num value={c.value} fd={fractionDigits(category, c.value)} lang={lang} class="font-semibold" />
                  {c.previous !== null && (
                    <ChangeText
                      change={{ from: c.previous, date: '', abs, pct: c.previous ? (abs / c.previous) * 100 : null }}
                      category={category}
                      lang={lang}
                      class="block text-sm text-ink-2 sm:ml-2 sm:inline"
                    />
                  )}
                </span>
              </li>
            );
          })}
        </ul>
      </section>
    )
  }
</Base>
