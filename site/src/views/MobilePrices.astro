---
import { PHONE_SHOPS, defaultDigits, formatNumber, type Lang } from '@bdnumbers/shared';
import Ago from '../components/Ago.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import Related from '../components/Related.astro';
import { STRINGS, localePath } from '../i18n';
import Base from '../layouts/Base.astro';
import { getLatest, getPhones } from '../lib/data';
import { BUDGETS, DEFAULT_FINDER, FINDER_PAGE, findPhones, finderCount, finderRow, type FinderPhone } from '../lib/phone-finder';
import { PHONES_PATH, brandPath, byBrand, lowestPrice, phonePath } from '../lib/phones';
import type { Faq as FaqItem } from '../lib/seo';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const bn = lang === 'bn';
const s = STRINGS[lang];
const p = s.phones;
const digits = defaultDigits(lang);
const phones = await getPhones();
const latest = await getLatest();
const brands = byBrand(phones.models);
const num = (n: number) => formatNumber(n, digits, 0);
const shops = PHONE_SHOPS.map((x) => x.name).join(', ');
const count = phones.models.length;
// The finder's data: every phone, short. The first rows are drawn here, the rest in the browser.
const finderData = {
  phones: phones.models.map((m): FinderPhone => [m.name, localePath(lang, phonePath(m)), m.brand, m.official, m.other, m.shops]),
  brands: Object.fromEntries(brands.map((b) => [b.brand.id, b.brand.name])),
  text: { official: p.official, other: p.other, out: p.out },
};
const first = findPhones(finderData.phones, DEFAULT_FINDER);
const rowOptions = { lang, digits, brands: finderData.brands, text: finderData.text, official: false };
const cheapest = (models: typeof phones.models) => {
  const prices = models.map(lowestPrice).filter((x): x is number => x !== null);
  return prices.length > 0 ? Math.min(...prices) : null;
};

const path = PHONES_PATH;
const title = bn
  ? `আজকের মোবাইল ফোনের দাম: ${num(PHONE_SHOPS.length)}টি দোকানের তুলনা`
  : `Mobile phone prices in Bangladesh: ${PHONE_SHOPS.length} shops compared`;
const description = bn
  ? `${count > 0 ? `${num(count)}টি মোবাইল ফোনের` : 'মোবাইল ফোনের'} দাম ${num(PHONE_SHOPS.length)}টি দোকানে পাশাপাশি: ${shops}। অফিসিয়াল ও আনঅফিসিয়াল আলাদা, প্রতিদিন হালনাগাদ।`
  : `${count > 0 ? `${count} mobile phones'` : 'Mobile phone'} prices at ${PHONE_SHOPS.length} shops side by side: ${shops}. Official and unofficial apart, updated daily.`;
const seen = phones.generated_at || null;

const faqs: FaqItem[] = bn
  ? [
      { q: 'কোন কোন দোকানের দাম দেখানো হয়?', a: `${shops}। প্রতিটি দোকানের নিজের ওয়েবসাইটে দেখানো দাম দিনে অন্তত একবার পড়া হয়।` },
      {
        q: 'অফিসিয়াল আর আনঅফিসিয়াল ফোনের দাম আলাদা কেন?',
        a: 'অফিসিয়াল ফোন ব্র্যান্ডের বাংলাদেশি পরিবেশকের মাধ্যমে আসে, সঙ্গে ব্র্যান্ডের ওয়ারেন্টি ও বিটিআরসির নিবন্ধন থাকে। আনঅফিসিয়াল ফোন দোকান নিজে আমদানি করে; দাম সাধারণত কম, ওয়ারেন্টি দোকানের। তাই দুটির দাম আলাদা কলামে দেখানো হয়।',
      },
      {
        q: 'তালিকার দাম কোন র‍্যাম/স্টোরেজের?',
        a: 'প্রতিটি দোকানের দেখানো সবচেয়ে কম দামের সংস্করণের। একই ফোনের বেশি র‍্যাম বা স্টোরেজের দাম বেশি; ফোনের পাতায় প্রতিটি দোকানের দাম ও সীমা দেখা যায়।',
      },
    ]
  : [
      { q: 'Which shops are compared?', a: `${shops}. Each shop's own website is read at least once a day.` },
      {
        q: 'Why are official and unofficial prices shown apart?',
        a: "An official phone comes through the brand's Bangladeshi distributor, with the brand's warranty and BTRC registration. An unofficial one is imported by the shop: usually cheaper, with the shop's own warranty. So the two are never mixed.",
      },
      {
        q: 'Which RAM/storage option is the price for?',
        a: "The cheapest option each shop lists. More RAM or storage costs more; each phone's page shows every shop's price and range.",
      },
    ];
---

<Base lang={lang} path={path} title={title} description={description} generatedAt={phones.generated_at || latest.generated_at}>
  <Breadcrumbs lang={lang} items={[{ label: s.nav.phones, path }]} />
  <h1 class="text-2xl font-semibold sm:text-3xl">{bn ? 'আজকের মোবাইল ফোনের দাম' : 'Mobile phone prices today'}</h1>
  <p class="mt-1 flex flex-wrap gap-x-2 text-sm text-ink-2">
    <span>{bn ? `${num(count)}টি ফোন · ${num(PHONE_SHOPS.length)}টি দোকানের দাম পাশাপাশি` : `${count} phones · ${PHONE_SHOPS.length} shops side by side`}</span>
    {seen && <span>· {s.updated}: <Ago at={seen} lang={lang} /></span>}
  </p>

  {
    count === 0 ? (
      <p class="card mt-6 p-4 text-ink-2">{p.notYet}</p>
    ) : (
      <>
        <section class="card mt-5 overflow-hidden" data-phone-finder aria-labelledby="finder-title">
          <div class="space-y-3 border-b border-grid p-4">
            <h2 id="finder-title" class="flex items-center gap-2 text-[0.9375rem] font-semibold text-ink-2">
              <span class="icon-chip" data-hue="phone"><Icon name="phone" /></span>
              {bn ? 'ফোন খুঁজুন' : 'Find a phone'}
            </h2>
            <input
              type="search"
              data-query
              autocomplete="off"
              aria-label={bn ? 'মডেলের নাম' : 'Model name'}
              placeholder={p.search}
              class="w-full rounded-lg border border-hairline bg-page px-3 py-2 text-ink outline-none focus-visible:border-accent"
            />
            <div role="group" aria-label={bn ? 'বাজেট' : 'Budget'} class="scroll-row -mx-4 flex gap-2 overflow-x-auto px-4 pb-0.5 text-sm">
              {
                BUDGETS.map((b) => (
                  <button
                    type="button"
                    data-budget={b.id}
                    aria-pressed={b.id === DEFAULT_FINDER.budget ? 'true' : 'false'}
                    class="shrink-0 whitespace-nowrap rounded-full border border-hairline px-3 py-1 text-ink-2 hover:text-ink aria-pressed:border-accent aria-pressed:bg-accent aria-pressed:text-accent-ink"
                  >
                    {b[lang]}
                  </button>
                ))
              }
            </div>
            <div class="grid grid-cols-2 gap-2 text-sm sm:flex sm:flex-wrap sm:items-center">
              <select data-brand aria-label={p.brands} class="rounded-lg border border-hairline bg-page px-2 py-1.5 text-ink">
                <option value="">{bn ? 'সব ব্র্যান্ড' : 'All brands'}</option>
                {brands.map(({ brand, models }) => <option value={brand.id}>{brand.name} ({num(models.length)})</option>)}
              </select>
              <select data-sort aria-label={bn ? 'সাজানো' : 'Sort'} class="rounded-lg border border-hairline bg-page px-2 py-1.5 text-ink">
                <option value="popular">{bn ? 'বেশি দোকানে আছে' : 'Most shops'}</option>
                <option value="low">{bn ? 'দাম: কম থেকে বেশি' : 'Price: low to high'}</option>
                <option value="high">{bn ? 'দাম: বেশি থেকে কম' : 'Price: high to low'}</option>
              </select>
              <label class="col-span-2 inline-flex items-center gap-2 text-ink-2 sm:ml-2">
                <input type="checkbox" data-official class="size-4 accent-[var(--accent)]" />
                {bn ? 'শুধু অফিসিয়াল দাম' : 'Official prices only'}
              </label>
            </div>
          </div>
          <p class="px-4 pt-3 text-xs text-muted" data-count aria-live="polite">{finderCount(first.length, lang, digits)}</p>
          <ul data-results class="divide-y divide-grid" set:html={first.slice(0, FINDER_PAGE).map((ph) => finderRow(ph, rowOptions)).join('')} />
          <p data-empty hidden class="px-4 py-6 text-center text-ink-2">{p.noMatch}</p>
          <div class="border-t border-grid p-3 text-center">
            <button
              type="button"
              data-more
              hidden={first.length <= FINDER_PAGE}
              class="rounded-full border border-hairline px-4 py-1.5 text-sm text-ink hover:border-accent"
            >
              {bn ? 'আরও দেখুন' : 'Show more'}
            </button>
          </div>
          <script type="application/json" is:inline set:html={JSON.stringify(finderData).replace(/</g, '\\u003c')} />
        </section>

        <section class="mt-8" aria-labelledby="brands-title">
          <h2 id="brands-title" class="mb-3 text-lg font-semibold">{bn ? 'ব্র্যান্ড অনুযায়ী দাম' : 'Prices by brand'}</h2>
          <ul class="grid grid-cols-2 gap-2 sm:grid-cols-3 md:grid-cols-4">
            {brands.map(({ brand, models }) => {
              const from = cheapest(models);
              return (
                <li>
                  <a href={localePath(lang, brandPath(brand.id))} class="card flex h-full flex-col px-3 py-2.5 no-underline hover:border-accent">
                    <span class="font-semibold text-ink">{brand.name}</span>
                    <span class="text-xs text-muted">
                      {bn ? `${num(models.length)}টি ফোন` : `${models.length} phones`}
                      {from !== null && (bn ? ` · ৳${num(from)} থেকে` : ` · from ৳${num(from)}`)}
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      </>
    )
  }

  <section class="mt-10 max-w-3xl space-y-3 text-[0.9375rem] text-ink-2">
    <h2 class="text-lg font-semibold text-ink">{bn ? 'দাম কোথা থেকে' : 'Where the prices come from'}</h2>
    <p>
      {
        bn
          ? 'প্রতিটি দাম দোকানের নিজের ওয়েবসাইট থেকে, দিনে অন্তত একবার পড়া। একই ফোন বিভিন্ন দোকান বিভিন্ন নামে লেখে; নাম মিলিয়ে একই মডেলের দাম পাশাপাশি রাখা হয়েছে। দোকান অফিসিয়াল না আনঅফিসিয়াল উল্লেখ না করলে দামটি "আনঅফিসিয়াল/অন্যান্য" কলামে থাকে। কেনার আগে দাম, ওয়ারেন্টি ও স্টক দোকানে যাচাই করুন।'
          : "Every price is read from the shop's own website at least once a day. Shops write the same phone in different ways; names are matched so each model's prices sit side by side. When a shop doesn't say whether a phone is official, its price goes in the \"unofficial/other\" column. Check the price, warranty and stock with the shop before you buy."
      }
    </p>
    <ul class="flex flex-wrap gap-x-4 gap-y-1">
      {
        PHONE_SHOPS.map((x) => (
          <li>
            <a href={x.url} rel="nofollow noopener" target="_blank">
              {x.name}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <Faq lang={lang} faqs={faqs} />

  <Related
    lang={lang}
    links={[
      { label: s.nav.dollar, path: '/dollar-rate-today' },
      { label: s.nav.market, path: '/market-price-today' },
      { label: s.nav.calculators, path: '/calculators' },
    ]}
  />
</Base>

<script>
  import '../scripts/phone-finder';
</script>
