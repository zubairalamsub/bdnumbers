---
import type { Lang } from '@bdnumbers/shared';
import { STRINGS, localePath } from '../i18n';
import Base from '../layouts/Base.astro';
import { getLatest } from '../lib/data';

interface Props {
  lang: Lang;
}

// Shown by the service worker for a page that was never opened before, while offline.
const { lang } = Astro.props;
const s = STRINGS[lang];
const bn = lang === 'bn';
const latest = await getLatest();
const links = [
  { label: s.nav.home, path: '/' },
  { label: s.nav.dollar, path: '/dollar-rate-today' },
  { label: s.nav.gold, path: '/gold-price-today' },
  { label: s.nav.market, path: '/market-price-today' },
  { label: s.nav.prayer, path: '/prayer-times' },
  { label: s.nav.calculators, path: '/calculators' },
];
---

<Base
  lang={lang}
  path="/offline"
  title={bn ? 'আপনি অফলাইনে আছেন' : 'You are offline'}
  description={bn ? 'ইন্টারনেট সংযোগ নেই।' : 'No internet connection.'}
  generatedAt={latest.generated_at}
  noindex
>
  <h1 class="text-2xl font-semibold sm:text-3xl">{bn ? 'আপনি অফলাইনে আছেন' : 'You are offline'}</h1>
  <p class="mt-3 max-w-2xl text-ink-2">
    {
      bn
        ? 'এই পাতাটি আগে খোলা হয়নি, তাই ইন্টারনেট ছাড়া দেখানো যাচ্ছে না। আগে খোলা পাতাগুলো শেষ দেখা তথ্যসহ অফলাইনেও খুলবে; প্রতিটি সংখ্যার পাশে কখন হালনাগাদ হয়েছিল তা লেখা থাকে।'
        : 'This page has not been opened on this device before, so it can’t be shown without a connection. Pages you opened before still work offline with the data they last showed, each number marked with when it was updated.'
    }
  </p>
  <ul class="mt-5 flex flex-wrap gap-2">
    {
      links.map((l) => (
        <li>
          <a href={localePath(lang, l.path)} class="card inline-block px-3 py-1.5 no-underline hover:underline">
            {l.label}
          </a>
        </li>
      ))
    }
  </ul>
</Base>
