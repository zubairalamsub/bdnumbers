---
import { defaultDigits, formatDate, formatNumber, toBengaliDigits, type Lang } from '@bdnumbers/shared';
import Field from '../../components/calc/Field.astro';
import Shell from '../../components/calc/Shell.astro';
import { MFS_RETRIEVED, MFS_SERVICES } from '../../lib/mfs-fees';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const bn = lang === 'bn';
const digits = defaultDigits(lang);
const d = (n: number) => (bn ? toBengaliDigits(String(n)) : String(n));
const rateLabel = (o: { per1000?: number; percent?: number }) =>
  o.per1000 !== undefined
    ? bn
      ? `হাজারে ${formatNumber(o.per1000, digits, 2)} টাকা`
      : `Tk ${formatNumber(o.per1000, digits, 2)} per 1,000`
    : `${formatNumber(o.percent ?? 0, digits, 2)}%`;
---

<Shell
  lang={lang}
  slug="mobile-banking"
  title={bn ? 'বিকাশ, নগদ ও রকেটে ক্যাশ-আউট খরচ' : 'bKash, Nagad and Rocket cash-out fees'}
  intro={bn ? 'কত টাকা ক্যাশ-আউট করবেন লিখুন; প্রতিটি সেবায় কত চার্জ কাটবে দেখুন।' : 'Enter how much you want to cash out to see the charge on each service.'}
>
  <form data-calc="mfs" data-services={JSON.stringify(MFS_SERVICES)}>
    <div class="max-w-sm">
      <Field name="amount" label={bn ? 'ক্যাশ-আউটের পরিমাণ' : 'Amount to cash out'} value={d(5000)} suffix={bn ? 'টাকা' : 'Tk'} />
    </div>
    {
      MFS_SERVICES.map((svc) => (
        <section class="mt-6">
          <h2 class="mb-2 text-lg font-semibold">{svc.name}</h2>
          <div class="overflow-x-auto">
            <table class="data-table text-[0.9375rem]">
              <thead>
                <tr>
                  <th scope="col">{bn ? 'কোথা থেকে' : 'Where'}</th>
                  <th scope="col">{bn ? 'চার্জের হার' : 'Rate'}</th>
                  <th scope="col">{bn ? 'চার্জ' : 'Charge'}</th>
                  <th scope="col">{bn ? 'মোট কাটবে' : 'Total deducted'}</th>
                </tr>
              </thead>
              <tbody>
                {svc.options.map((o) => (
                  <tr>
                    <th scope="row" class="font-normal">
                      {bn ? o.bn : o.en}
                    </th>
                    <td class="text-ink-2">{rateLabel(o)}</td>
                    <td class="font-semibold" data-out={`${svc.id}.${o.id}.fee`}>
                      —
                    </td>
                    <td data-out={`${svc.id}.${o.id}.total`}>—</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="mt-1 text-xs text-muted">
            {bn ? 'উৎস: ' : 'Source: '}
            <a href={svc.sourceUrl} rel="noopener" target="_blank">{svc.name}</a>
            {svc.asOf && (bn ? ` · সর্বশেষ প্রকাশিত হার মার্চ ২০২৫-এর; বর্তমান হার ভিন্ন হতে পারে` : ` · newest published rates are from March 2025 and may have changed`)}
          </p>
        </section>
      ))
    }
  </form>
  <p slot="notes">
    {
      bn
        ? `হার প্রতিটি প্রতিষ্ঠানের নিজস্ব ওয়েবসাইট থেকে, ${formatDate(MFS_RETRIEVED, lang, digits)} তারিখে যাচাই করা। চার্জ আপনার ব্যালান্স থেকে আলাদাভাবে কাটে; অফার বা ক্যাম্পেইনে কম হতে পারে।`
        : `Rates are from each operator's own website, checked on ${formatDate(MFS_RETRIEVED, lang, digits)}. The charge is deducted from your balance on top of the amount; offers and campaigns can make it lower.`
    }
  </p>
</Shell>

<script>
  import { bindCalculator } from '../../lib/calc-ui';
  import { cashOutFee, type MfsService } from '../../lib/mfs-fees';

  const form = document.querySelector<HTMLFormElement>('[data-calc="mfs"]');
  if (form) {
    const services = JSON.parse(form.dataset.services!) as MfsService[];
    bindCalculator(form, (c) => {
      const amount = c.num('amount');
      for (const svc of services) {
        for (const o of svc.options) {
          const fee = Number.isFinite(amount) && amount > 0 ? cashOutFee(o, amount) : Number.NaN;
          c.out(`${svc.id}.${o.id}.fee`, c.taka(fee));
          c.out(`${svc.id}.${o.id}.total`, c.taka(amount + fee));
        }
      }
    });
  }
</script>
