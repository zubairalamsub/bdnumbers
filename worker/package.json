{
  "name": "@bdnumbers/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply bdnumbers --local",
    "migrate:remote": "wrangler d1 migrations apply bdnumbers --remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p scripts/tsconfig.json",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@bdnumbers/shared": "*",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.6",
    "@cloudflare/workers-types": "^5.20261022.1",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "~5.0.5",
    "wrangler": "^4.151.3"
  }
}
